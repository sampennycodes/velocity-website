# Preferred contact-email key from the verified Velocity Marketing Resend account.
# Server-only: never commit real keys or expose either key to the browser.
RESEND_API_KEY_NEW=
# Optional legacy fallback while rotating keys.
RESEND_API_KEY=
# Sender, recipients and email text are edited in CMS > Contact emails.
# Default sender: Velocity Marketing <website@velocitymarketing.com.au>
# SEND_EMAIL_FROM and SEND_EMAIL_TO are obsolete for this V2 handler.
# Optional: disable delivery in an environment. Vercel previews are disabled automatically.
CONTACT_FORM_DISABLED=false
# Cloudflare Turnstile managed widget for velocitymarketing.com.au (including www).
# Public site key is embedded at build time; the secret is server-only.
PUBLIC_TURNSTILE_SITE_KEY=
TURNSTILE_SECRET_KEY=
# Optional for static review builds outside Vercel. Disables frontend sending, indexing and analytics.
PUBLIC_SITE_PREVIEW=false

# Client editor: staging only, disabled unless explicitly enabled.
EDITOR_ENABLED=false
EDITOR_ENVIRONMENT=staging
# Exact comma-separated origins; never wildcard a staging origin.
EDITOR_ORIGINS=http://localhost:4321,http://127.0.0.1:4321
DATABASE_URL=
DATABASE_URL_UNPOOLED=
NEON_AUTH_BASE_URL=
# Delivery gate: only add explicitly released accounts. Codes are sent on request.
EDITOR_OTP_EMAILS=sam@sampenny.io
# Separate PRIVATE Blob store connected to preview/development only.
EDITOR_BLOB_PRIVATE_TOKEN=
EDITOR_BLOB_PUBLIC_TOKEN=
EDITOR_PUBLISH_ENABLED=false
# Server-selected destination; the browser cannot override it.
EDITOR_PUBLISH_TARGET=staging
# Production builds only: enable immutable CMS content and use a read-only DB role.
EDITOR_CONTENT_ENABLED=false
EDITOR_CONTENT_DATABASE_URL=
EDITOR_VERCEL_TOKEN=
EDITOR_VERCEL_TEAM_ID=
EDITOR_VERCEL_PROJECT_ID=
# Full 40-character commit from codex/visual-refresh; must include editor code.
EDITOR_APPROVED_SOURCE_SHA=
# Supplied by the publishing service per build; never set to a moving pointer.
VELOCITY_INTEGRATION_REVISION=
# Explicit immutable content snapshot supplied by the publishing service.
VELOCITY_CONTENT_REVISION=
VELOCITY_CONTENT_JOB=
