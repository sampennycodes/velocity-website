# Use a key created in Mike's Resend account. Never commit real keys.
RESEND_API_KEY=
# Only use after velocitymarketing.com.au is verified in that Resend account.
SEND_EMAIL_FROM="Velocity Marketing <mike@velocitymarketing.com.au>"
SEND_EMAIL_TO=mike@velocitymarketing.com.au
# Optional: disable delivery in an environment. Vercel previews are disabled automatically.
CONTACT_FORM_DISABLED=false
# Optional for static review builds outside Vercel. Disables frontend sending, indexing and analytics.
PUBLIC_SITE_PREVIEW=false
