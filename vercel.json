{
  "headers": [
    {
      "source": "/optimized/:path*",
      "headers": [{ "key": "Cache-Control", "value": "public, max-age=31536000, immutable" }]
    },
    {
      "source": "/favicon.ico",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=31536000, immutable"
        },
        {
          "key": "Content-Type",
          "value": "image/x-icon"
        }
      ]
    },
    {
      "source": "/admin/:path*",
      "headers": [
        {
          "key": "X-Robots-Tag",
          "value": "noindex, nofollow"
        },
        {
          "key": "Cache-Control",
          "value": "private, no-store"
        },
        {
          "key": "X-Frame-Options",
          "value": "SAMEORIGIN"
        },
        {
          "key": "Referrer-Policy",
          "value": "same-origin"
        },
        {
          "key": "Content-Security-Policy",
          "value": "frame-ancestors 'self'"
        }
      ]
    },
    {
      "source": "/api/editor",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "private, no-store"
        },
        {
          "key": "X-Content-Type-Options",
          "value": "nosniff"
        }
      ]
    }
  ],
  "redirects": [
    {
      "source": "/admin/:path*",
      "has": [{ "type": "host", "value": "velocitymarketing.com.au" }],
      "destination": "https://velocitymarketing-v2.vercel.app/admin/:path*",
      "permanent": false
    },
    {
      "source": "/admin/:path*",
      "has": [{ "type": "host", "value": "www.velocitymarketing.com.au" }],
      "destination": "https://velocitymarketing-v2.vercel.app/admin/:path*",
      "permanent": false
    },
    {
      "source": "/sitemap.xml",
      "destination": "/sitemap-index.xml",
      "permanent": true
    }
  ],
  "functions": {
    "api/contact.js": {
      "includeFiles": ".generated/contact-email-settings.json"
    },
    "api/editor-api.js": {
      "regions": ["syd1"],
      "maxDuration": 300
    }
  },
  "rewrites": [
    {
      "source": "/api/editor",
      "destination": "/api/editor-api"
    }
  ]
}
