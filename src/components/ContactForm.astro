---
const isPreview = import.meta.env.DEV || import.meta.env.VERCEL_ENV === 'preview' || import.meta.env.PUBLIC_SITE_PREVIEW === 'true';
---
<form action="/api/contact" method="post" id="contact-form" class="form form-hero" novalidate data-preview={String(isPreview)}>
  <div class="honeypot-field" aria-hidden="true"><label for="website">Website</label><input type="text" id="website" name="website" tabindex="-1" autocomplete="off" /></div>
  <div class="form__row two-up">
    <div class="form__row"><label class="label" for="name">Your name <span class="required">*</span></label><input id="name" name="name" class="input" type="text" required maxlength="120" autocomplete="name" placeholder="Alex Smith" aria-describedby="error-name" /><span id="error-name" class="form__error" hidden>Please enter your name.</span></div>
    <div class="form__row"><label class="label" for="email">Email address <span class="required">*</span></label><input id="email" name="email" class="input" type="email" required maxlength="254" autocomplete="email" placeholder="alex@yourbusiness.com" aria-describedby="error-email" /><span id="error-email" class="form__error" hidden>Please enter a valid email address.</span></div>
  </div>
  <div class="form__row"><label class="label" for="phone">Phone number <span class="optional">(optional)</span></label><input id="phone" name="phone" class="input" type="tel" maxlength="50" autocomplete="tel" placeholder="Your best contact number" /></div>
  <div class="form__row"><label class="label" for="message">How can I help? <span class="required">*</span></label><textarea id="message" name="message" class="textarea" rows="5" required maxlength="10000" placeholder="A little about your business, your goals, and what you have in mind…" aria-describedby="error-message"></textarea><span id="error-message" class="form__error" hidden>Please tell me a little about what you need.</span></div>
  <div class="form__actions"><button class="btn primary" type="submit">Let’s start a conversation <span aria-hidden="true">↗</span></button><span id="contact-status" role="status" aria-live="polite" class="form__status"></span></div>
</form>
<script>
  const form = document.querySelector<HTMLFormElement>('#contact-form');
  const status = document.querySelector<HTMLElement>('#contact-status');
  const button = form?.querySelector<HTMLButtonElement>('button[type="submit"]');
  const fields = ['name', 'email', 'message'].map(id => document.getElementById(id) as HTMLInputElement | HTMLTextAreaElement);
  function validate(field: HTMLInputElement | HTMLTextAreaElement) {
    const valid = Boolean(field.value.trim()) && field.validity.valid;
    document.getElementById(`error-${field.id}`)!.hidden = valid;
    field.setAttribute('aria-invalid', String(!valid));
    return valid;
  }
  fields.forEach(field => field.addEventListener('input', () => { if (field.getAttribute('aria-invalid') === 'true') validate(field); }));
  form?.addEventListener('submit', async event => {
    event.preventDefault();
    if (!status || !button || button.disabled) return;
    const invalid = fields.filter(field => !validate(field));
    if (invalid.length) { status.textContent = 'Please check the highlighted fields.'; invalid[0].focus(); return; }
    const data = Object.fromEntries(new FormData(form));
    if (String(data.website).trim()) { status.textContent = 'Submission blocked.'; return; }
    if (form.dataset.preview === 'true') { status.textContent = 'Preview only — your form is complete, but no email has been sent.'; return; }
    button.disabled = true;
    form.setAttribute('aria-busy', 'true');
    status.textContent = 'Sending your message…';
    try {
      const response = await fetch('/api/contact', { method: 'POST', headers: { 'Content-Type': 'application/json' }, body: JSON.stringify(data) });
      const result = await response.json();
      if (response.ok && result.success) { status.textContent = 'Thanks! I’ll be in touch shortly.'; form.reset(); }
      else { status.textContent = result.message || 'Your message could not be sent. Please try again or email Mike directly.'; }
    } catch { status.textContent = 'Your message could not be sent. Please try again or email Mike directly.'; }
    finally { button.disabled = false; form.removeAttribute('aria-busy'); }
  });
</script>
<style>button:disabled { opacity: .6; cursor: wait; transform: none; }</style>
