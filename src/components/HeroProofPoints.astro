---
// Australian flag: https://github.com/lipis/flag-icons/blob/main/flags/4x3/au.svg
// License retained at /flag-icons-LICENSE.txt.
const experienceBars = [7, 10, 13, 17, 21, 25, 29];
---

<div class="stats hero-stats" data-proof-points aria-label="Experience and approach">
  <div class="stat">
    <div class="proof-heading">
      <span class="stat__num">10</span>
      <span class="proof-art" aria-hidden="true">
        <svg viewBox="0 0 80 36" width="80" height="36" fill="none" focusable="false">
          {experienceBars.map((height, index) => (
            <path class="experience-bar" d={`M${8 + index * 10} 32V${32 - height}`} pathLength="1" stroke="#b9a4ff" stroke-width="2.5" stroke-linecap="round" stroke-opacity={0.55 + index * 0.075} style={`--bar-delay:${index * 90}ms`} />
          ))}
        </svg>
      </span>
    </div>
    <span class="stat__label">Years Experience</span>
  </div>
  <div class="stat">
    <div class="proof-heading">
      <span class="stat__num">AU</span>
      <span class="proof-art" aria-hidden="true">
        <img class="australia-flag" src="/australia-flag.svg" alt="" width="36" height="27" />
      </span>
    </div>
    <span class="stat__label">Locally Based</span>
  </div>
  <div class="stat">
    <div class="proof-heading">
      <span class="stat__num">ROI</span>
      <span class="proof-art" aria-hidden="true">
        <svg viewBox="0 0 80 36" width="80" height="36" fill="none" focusable="false">
          <path class="proof-guide" d="M4 4V32H76M4 18H76" />
          <path class="proof-line roi-line" d="M5 28L19 24L31 26L46 16L57 18L72 4" pathLength="1" />
          <path class="proof-line roi-tip" d="M65 4H72V11" />
        </svg>
      </span>
    </div>
    <span class="stat__label">Performance Focus</span>
  </div>
</div>

<script is:inline>
  (() => {
    const points = document.querySelector('[data-proof-points]');
    const motion = window.matchMedia('(prefers-reduced-motion: reduce)');
    if (!points || !('IntersectionObserver' in window) || motion.matches) return;

    let played = false;

    const observer = new IntersectionObserver((entries) => {
      if (!played && entries.some(entry => entry.isIntersecting)) {
        played = true;
        points.classList.add('is-animated');
        observer.disconnect();
      }
    }, { threshold: 0.35 });
    points.classList.add('motion-ready');
    observer.observe(points);
  })();
</script>

<style>
  .stat {
    grid-template-rows:auto 1fr;
  }
  .proof-heading {
    display:flex;
    align-items:center;
    gap:20px;
    min-height:44px;
  }
  .proof-art {
    display:inline-flex;
    align-items:center;
    width:80px;
    height:36px;
    flex-shrink:0;
  }
  .proof-art svg {
    display:block;
    width:100%;
    height:100%;
    overflow:visible;
  }
  .australia-flag {
    width:36px;
    height:27px;
    border-radius:2px;
    outline:1px solid #ffffff26;
    outline-offset:0;
  }
  .proof-guide {
    stroke:var(--border);
    stroke-width:1;
  }
  .proof-line {
    stroke:var(--accent);
    stroke-width:2;
    stroke-linecap:round;
    stroke-linejoin:round;
  }
  @media (prefers-reduced-motion:no-preference) {
    .motion-ready .experience-bar,.motion-ready .roi-line {
      stroke-dasharray:1;
      stroke-dashoffset:1;
    }
    .motion-ready .roi-tip {
      opacity:0;
    }
    .is-animated .experience-bar {
      animation:proof-draw .8s var(--bar-delay) cubic-bezier(.22,1,.36,1) forwards;
    }
    .is-animated .roi-line {
      animation:proof-draw 1.4s .15s cubic-bezier(.25,.1,.25,1) forwards;
    }
    .is-animated .roi-tip {
      animation:proof-finish .25s 1.4s ease-out forwards;
    }
  }
  @keyframes proof-draw {
    to { stroke-dashoffset:0; }
  }
  @keyframes proof-finish {
    to { opacity:1; }
  }
  @media (max-width:600px) {
    .proof-heading {
      flex-direction:column-reverse;
      align-items:flex-start;
      gap:6px;
      min-height:58px;
    }
    .proof-art {
      width:64px;
      height:28px;
    }
    .australia-flag {
      width:32px;
      height:24px;
    }
  }
</style>
