---
// Australian flag: https://github.com/lipis/flag-icons/blob/main/flags/4x3/au.svg
// License retained at /flag-icons-LICENSE.txt.
---

<div class="stats hero-stats" data-proof-points aria-label="Experience and approach">
  <div class="stat">
    <div class="proof-heading">
      <span class="stat__num experience-number"><span data-experience-count aria-hidden="true">10</span><span class="experience-accessible">10</span></span>
    </div>
    <span class="stat__label">Years Experience</span>
  </div>
  <div class="stat">
    <div class="proof-heading">
      <span class="stat__num">AU</span>
      <span class="proof-art" aria-hidden="true">
        <img class="australia-flag" src="/australia-flag.svg" alt="" width="36" height="27" />
      </span>
    </div>
    <span class="stat__label">Locally Based</span>
  </div>
  <div class="stat">
    <div class="proof-heading">
      <span class="stat__num">ROI</span>
      <span class="proof-art" aria-hidden="true">
        <svg viewBox="0 0 80 36" width="80" height="36" fill="none" focusable="false">
          <path class="proof-guide" d="M4 4V32H76M4 18H76" />
          <path class="proof-line roi-line" d="M5 28L19 24L31 26L46 16L57 18L72 4" pathLength="1" />
          <path class="proof-line roi-tip" d="M65 4H72V11" />
        </svg>
      </span>
    </div>
    <span class="stat__label">Performance Focus</span>
  </div>
</div>

<script is:inline>
  (() => {
    const points = document.querySelector('[data-proof-points]');
    const motion = window.matchMedia('(prefers-reduced-motion: reduce)');
    if (!points || !('IntersectionObserver' in window) || motion.matches) return;

    const counter = points.querySelector('[data-experience-count]');
    const target = Number(counter?.textContent || '10');
    let played = false;

    const countUp = () => {
      if (!counter || motion.matches) return;
      let start;
      counter.textContent = '0';

      const tick = (now) => {
        if (motion.matches) {
          counter.textContent = String(target);
          return;
        }
        start ??= now;
        const progress = Math.min((now - start) / 1200, 1);
        const eased = 1 - (1 - progress) ** 2;
        counter.textContent = String(Math.round(target * eased));
        if (progress < 1) requestAnimationFrame(tick);
      };
      requestAnimationFrame(tick);
    };

    const observer = new IntersectionObserver((entries) => {
      if (!played && entries.some(entry => entry.isIntersecting)) {
        played = true;
        points.classList.add('is-animated');
        countUp();
        observer.disconnect();
      }
    }, { threshold: 0.35 });
    points.classList.add('motion-ready');
    observer.observe(points);
  })();
</script>

<style>
  .stat {
    grid-template-rows:auto 1fr;
  }
  .proof-heading {
    display:flex;
    align-items:center;
    gap:20px;
    min-height:44px;
  }
  .experience-number {
    position:relative;
    font-size:2.25rem;
    font-weight:600;
    line-height:1;
    letter-spacing:-.06em;
    font-variant-numeric:tabular-nums;
  }
  [data-experience-count] {
    display:inline-block;
    min-width:2ch;
  }
  .experience-accessible {
    position:absolute;
    width:1px;
    height:1px;
    padding:0;
    margin:-1px;
    overflow:hidden;
    clip-path:inset(50%);
    white-space:nowrap;
  }
  .proof-art {
    display:inline-flex;
    align-items:center;
    width:80px;
    height:36px;
    flex-shrink:0;
  }
  .proof-art svg {
    display:block;
    width:100%;
    height:100%;
    overflow:visible;
  }
  .australia-flag {
    width:36px;
    height:27px;
    border-radius:2px;
    outline:1px solid #ffffff26;
    outline-offset:0;
  }
  .proof-guide {
    stroke:var(--border);
    stroke-width:1;
  }
  .proof-line {
    stroke:var(--accent);
    stroke-width:2;
    stroke-linecap:round;
    stroke-linejoin:round;
  }
  @media (prefers-reduced-motion:no-preference) {
    .motion-ready .roi-line {
      stroke-dasharray:1;
      stroke-dashoffset:1;
    }
    .motion-ready .roi-tip {
      opacity:0;
    }
    .is-animated .roi-line {
      animation:proof-draw 1.4s .15s cubic-bezier(.25,.1,.25,1) forwards;
    }
    .is-animated .roi-tip {
      animation:proof-finish .25s 1.4s ease-out forwards;
    }
  }
  @keyframes proof-draw {
    to { stroke-dashoffset:0; }
  }
  @keyframes proof-finish {
    to { opacity:1; }
  }
  @media (max-width:600px) {
    .proof-heading {
      flex-direction:column-reverse;
      align-items:flex-start;
      gap:6px;
      min-height:58px;
    }
    .experience-number {
      font-size:2.5rem;
    }
    .proof-art {
      width:64px;
      height:28px;
    }
    .australia-flag {
      width:32px;
      height:24px;
    }
  }
</style>
