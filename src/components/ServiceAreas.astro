---
import { regions, locationMap, nearbyLocations } from '../../lib/content/locations.js';
import type { SiteContent } from '../../lib/content/types';
interface Props { content: SiteContent; locationSlug?: string; }
const { content, locationSlug } = Astro.props;
const location = locationSlug ? locationMap[locationSlug] : null;
const group = location ? `${location.page}.areas` : 'home.areas';
const headingKey = `${group}.heading`;
---
<section id="areas-we-service" class:list={['service-areas', location ? 'section' : 'home-areas']} data-editor-group={group}>
  <div class="container">
    {location ? (
      <>
        <h2 class="h2 reveal" data-content-text={headingKey}>{content.values[headingKey]}</h2>
        <ul class="area-links nearby-links reveal">
          {nearbyLocations(location.slug).map(town => <li><a href={town.path}>{town.name}<span aria-hidden="true">↗</span></a></li>)}
        </ul>
      </>
    ) : (
      <>
        <p class="area-intro" data-content-text="home.areas.intro">{content.values['home.areas.intro']}</p>
        <details class="areas-disclosure">
          <summary>
            <h2>
              <span data-content-text={headingKey}>{content.values[headingKey]}</span>
              <svg class="disclosure-icon" width="14" height="14" viewBox="0 0 16 16" fill="none" stroke="currentColor" stroke-width="1.5" aria-hidden="true"><path d="M3 6l5 5 5-5" /></svg>
            </h2>
          </summary>
          <div class="area-regions">
            {regions.map(region => <div class="area-region">
              <h3>{region.name}</h3>
              <ul class="area-links">{region.slugs.map(slug => <li><a href={locationMap[slug].path}>{locationMap[slug].name}</a></li>)}</ul>
            </div>)}
          </div>
        </details>
      </>
    )}
  </div>
</section>
<style>
  .service-areas { border-top: 1px solid var(--border, #ffffff1f); }
  .service-areas .h2 { margin-bottom: 2.5rem; }
  .home-areas { padding-block: 2.5rem; }
  .area-intro { max-width: 48rem; margin: 0; color: var(--muted); font-size: 1rem; line-height: 1.7; }
  .areas-disclosure { margin-top: .75rem; }
  .areas-disclosure summary { width: fit-content; padding-block: .75rem; cursor: pointer; list-style: none; color: var(--muted); }
  .areas-disclosure summary::-webkit-details-marker { display: none; }
  .areas-disclosure summary h2 { display: flex; align-items: center; gap: .7rem; margin: 0; font-size: .95rem; line-height: 1.5; font-weight: 500; }
  .areas-disclosure summary:hover { color: var(--text); }
  .areas-disclosure summary:focus-visible { outline: 2px solid var(--accent, #c79bff); outline-offset: 4px; }
  .disclosure-icon { flex-shrink: 0; }
  .areas-disclosure[open] .disclosure-icon { transform: rotate(180deg); }
  .area-regions { display: grid; grid-template-columns: repeat(3, minmax(0, 1fr)); gap: 1.25rem 2rem; padding-top: .75rem; }
  .area-region h3 { font-size: .875rem; margin: 0 0 .35rem; color: var(--muted); }
  .area-links { list-style: none; padding: 0; margin: 0; }
  .area-links li { border-bottom: 1px solid #ffffff1f; }
  .area-links a { display: flex; align-items: center; justify-content: space-between; gap: 1rem; min-height: 48px; padding: .65rem 0; font-size: 1rem; text-decoration: none; }
  .area-links a span { color: var(--accent, #c79bff); transition: transform .2s; }
  .area-links a:hover { color: var(--accent, #c79bff); }
  .area-links a:hover span { transform: translate(2px, -2px); }
  .area-links a:focus-visible { outline: 2px solid var(--accent, #c79bff); outline-offset: 4px; }
  .area-regions .area-links { display: flex; flex-wrap: wrap; column-gap: 1rem; }
  .area-regions .area-links li { border: 0; }
  .area-regions .area-links a { display: inline-block; min-height: 32px; padding: .3rem 0; font-size: .9rem; line-height: 1.6; color: var(--muted); text-decoration: underline; text-decoration-color: #ffffff40; text-underline-offset: 3px; }
  .area-regions .area-links a:hover { color: var(--text); text-decoration-color: currentColor; }
  .nearby-links { display: grid; grid-template-columns: repeat(4, minmax(0, 1fr)); gap: 0 2rem; }
  @media (max-width: 900px) { .area-regions, .nearby-links { grid-template-columns: repeat(2, minmax(0, 1fr)); } }
  @media (max-width: 540px) { .area-regions, .nearby-links { grid-template-columns: 1fr; } }
  @media (prefers-reduced-motion: reduce) { .area-links a span { transition: none; } }
</style>
