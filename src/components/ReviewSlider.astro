---
interface Review {
  name: string;
  business: string;
  quote: string;
  image?: string;
}

const reviews: Review[] = [
  {
    name: "Tom Galland",
    business: "SEO Growth",
    quote: "Working with Mike has been a real game-changer for us. We'd spent years trying to find an agency that actually understood what we were aiming to achieve and knew how to put the right strategies in place.",
  },
  {
    name: "Hanlon Clarke",
    business: "Happy Travels",
    quote: "We've worked with a bunch of digital marketers over the years and honestly Mike is in a different league. He just gets it.",
  },
  {
    name: "Jasmine Crutchfield",
    business: "The Collective. Cospace",
    quote: "Such a fantastic experience working with Mike on our Meta campaign. Mike brings a deep understanding of the platform, clear strategy, and a creative and data-driven approach that helped us reach and engage our audience effectively.",
  }
];

---
<section class="section reviews-section" aria-labelledby="reviews-heading">
  <div class="container">
    <span class="eyebrow section-kicker">Perfect 5* Rating</span>
    <div class="section-heading reveal"><h2 class="h2" id="reviews-heading">What Clients Say</h2><p class="lead">Backed by measurable performance and transparent communication, our partners consistently rate us five stars.</p></div>
    <div class="reviews-grid">
      {reviews.map(review => <figure class="review-card reveal">
        <div class="review-stars" aria-label="Rated five out of five stars">★★★★★</div>
        <blockquote>“{review.quote}”</blockquote>
        <figcaption><span class="review-initials" aria-hidden="true">{review.name.split(' ').map(part => part[0]).join('')}</span><span><strong>{review.name}</strong><span class="review-business">{review.business}</span></span></figcaption>
      </figure>)}
    </div>
  </div>
</section>
<style>
  .reviews-section { background: #191919; border-block: 1px solid var(--border); }
  .reviews-grid { display: grid; grid-template-columns: repeat(3, minmax(0, 1fr)); gap: 20px; align-items: stretch; }
  .review-card { display: flex; flex-direction: column; padding: 30px; border: 1px solid #424242; border-radius: 10px; background: #202020; }
  .review-stars { color: var(--accent); letter-spacing: .18em; font-size: 1rem; margin-bottom: 26px; }
  blockquote { color: var(--heading); font-size: 1rem; line-height: 1.9; margin: 0 0 36px; }
  figcaption { margin-top: auto; display: flex; gap: 12px; align-items: center; font-size: .875rem; }
  figcaption strong { display: block; font-weight: 700; }
  .review-business { color: var(--muted); display: block; font-size: .8125rem; }
  .review-initials { width: 40px; height: 40px; border: 1px solid #737373; border-radius: 50%; display: grid; place-items: center; font-size: .75rem; }
  .review-card:nth-child(2) { background: var(--brand-purple); color: #ffffff; border-color: var(--brand-purple); }
  .review-card:nth-child(2) blockquote { color: #ffffff; font: 500 clamp(1.4rem, 2vw, 1.9rem)/1.45 var(--font-heading); letter-spacing: -.035em; }
  .review-card:nth-child(2) .review-stars { color: #ffffff; }
  .review-card:nth-child(2) .review-initials { border-color: var(--brand-purple-light); }
  .review-card:nth-child(2) .review-business { color: var(--brand-purple-ink); }
  @media (max-width: 1000px) { .reviews-grid { gap: 14px; } .review-card { padding: 24px; } }
  @media (max-width: 820px) { .reviews-grid { grid-template-columns: 1fr; } .review-card { padding: 28px; } .review-card:nth-child(2) blockquote { font-size: 1.65rem; } }
</style>
