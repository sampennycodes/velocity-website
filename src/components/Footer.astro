---
import { value, format } from "../../lib/content/model.js";
import { imageSource } from "../../lib/site.js";
const { content } = Astro.props;
const v = key => value(content, key);
---
<footer data-editor-group="shared.navigation" class="footer">
  <div class="container">
    <div class="footer-top">
      <a href="/" aria-label="Velocity Marketing home"><img src={imageSource('/logo.png')} alt="Velocity Marketing" width="3509" height="983" class="footer-logo" loading="lazy" /></a>
      <p><span data-content-text="shared.footer.message">{v("shared.footer.message")}</span> <span aria-hidden="true">👋🏻</span></p>
    </div>
    <div class="footer-bottom"><p data-content-text="shared.footer.copyright" data-text-format="copyright">{format(v("shared.footer.copyright"), "copyright")}</p><a data-content-href="shared.footer.topLink" data-content-text="shared.footer.topLabel" href={v("shared.footer.topLink")}>{v("shared.footer.topLabel")}</a></div>
  </div>
</footer>
