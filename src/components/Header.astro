---
import { value, format } from "../../lib/content/model.js";
const { content, editing = false } = Astro.props;
const v = key => value(content, key);
const sectionPrefix = editing ? "" : ['/','/google-ads-traralgon','/traralgon'].includes(Astro.url.pathname.replace(/\/$/, '') || '/') ? '' : '/';
const links = ['services', 'about'].map(key => ({ key, href: v(`shared.nav.${key}Link`), label: v(`shared.nav.${key}Label`) }));
const destination = link => link.startsWith('#') ? sectionPrefix + link : link;
---
<header data-editor-group="shared.navigation" class="header">
  <div class="container header__inner">
    <a href="/" class="header__brand" aria-label="Velocity Marketing home"><img src="/logo.png" alt="Velocity Marketing" width="3509" height="983" /></a>
    <div class="header__actions">
      <nav class="nav" id="site-nav" aria-label="Main navigation">
        <div class="nav__links">
          {links.map(link => <a class="nav__link" data-content-href={`shared.nav.${link.key}Link`} data-content-text={`shared.nav.${link.key}Label`} href={destination(link.href)}>{link.label}</a>)}
        </div>
        <div class="nav__buttons">
          <a class="nav__link nav__cta" data-content-href="shared.nav.contactLink" href={destination(v("shared.nav.contactLink"))}><span data-content-text="shared.nav.contactLabel">{v("shared.nav.contactLabel")}</span> <span aria-hidden="true">↗</span></a>
          <a class="nav__phone-link" data-content-href="shared.contact.phoneLink" data-href-format="tel" data-content-label="shared.contact.phone" data-label-format="call-label" href={format(v("shared.contact.phoneLink"), "tel")} aria-label={format(v("shared.contact.phone"), "call-label")}><svg width="20" height="20" viewBox="0 0 24 24" aria-hidden="true"><path fill="currentColor" d="M6.62 10.79a15.053 15.053 0 006.59 6.59l2.2-2.2a1 1 0 011.01-.24c1.12.37 2.33.57 3.58.57a1 1 0 011 1V20a1 1 0 01-1 1C10.07 21 3 13.93 3 5a1 1 0 011-1h3.5a1 1 0 011 1c0 1.25.2 2.46.57 3.58a1 1 0 01-.24 1.01l-2.2 2.2z" /></svg></a>
        </div>
      </nav>
      <a class="nav__phone-btn" data-content-href="shared.contact.phoneLink" data-href-format="tel" data-content-label="shared.contact.phone" data-label-format="call-label" href={format(v("shared.contact.phoneLink"), "tel")} aria-label={format(v("shared.contact.phone"), "call-label")}><svg width="20" height="20" viewBox="0 0 24 24" aria-hidden="true"><path fill="currentColor" d="M6.62 10.79a15.053 15.053 0 006.59 6.59l2.2-2.2a1 1 0 011.01-.24c1.12.37 2.33.57 3.58.57a1 1 0 011 1V20a1 1 0 01-1 1C10.07 21 3 13.93 3 5a1 1 0 011-1h3.5a1 1 0 011 1c0 1.25.2 2.46.57 3.58a1 1 0 01-.24 1.01l-2.2 2.2z" /></svg></a>
      <button class="nav__toggle" aria-controls="site-nav" aria-expanded="false" aria-label="Open menu"><span class="hamburger-icon" aria-hidden="true"><span class="hamburger-line"></span><span class="hamburger-line"></span><span class="hamburger-line"></span></span></button>
    </div>
  </div>
</header>
<script>
  const toggle = document.querySelector<HTMLButtonElement>('.nav__toggle');
  const nav = document.getElementById('site-nav');
  function setMenu(open: boolean) {
    nav?.classList.toggle('open', open);
    toggle?.setAttribute('aria-expanded', String(open));
    toggle?.setAttribute('aria-label', open ? 'Close menu' : 'Open menu');
  }
  toggle?.addEventListener('click', () => setMenu(toggle.getAttribute('aria-expanded') !== 'true'));
  nav?.querySelectorAll('a').forEach(link => link.addEventListener('click', () => setMenu(false)));
  document.addEventListener('keydown', event => {
    if (event.key === 'Escape' && toggle?.getAttribute('aria-expanded') === 'true') { setMenu(false); toggle.focus(); }
  });
  document.addEventListener('click', event => { if (event.target instanceof Node && !document.querySelector('.header')?.contains(event.target)) setMenu(false); });
</script>
