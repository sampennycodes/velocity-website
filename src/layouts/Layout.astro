---
import Header from "../components/Header.astro";
import Footer from "../components/Footer.astro";
import "../styles/global.css";
import manropeFont from "../assets/fonts/manrope-latin-variable.woff2?url";
import spaceGroteskFont from "../assets/fonts/space-grotesk-latin-variable.woff2?url";

import { buildContent, buildRevision } from "../../lib/content/build.js";
export interface Props {
  content?: any;
  editing?: boolean;
  socialImage?: string;
  socialImageWidth?: number;
  socialImageHeight?: number;
  title?: string;
  description?: string;
  canonical?: string;
  noIndex?: boolean;
}

const {
  title = "Velocity Marketing — Paid Media Specialist",
  description = "Data-driven paid media for measurable growth.",
  canonical = "https://velocitymarketing.com.au/",
  noIndex = false,
  content = buildContent,
  editing = false,
  socialImage = "/ogimage.png",
  socialImageWidth = 1200,
  socialImageHeight = 630
} = Astro.props as Props;
const isPreview = editing || import.meta.env.DEV || import.meta.env.VERCEL_ENV === 'preview' || import.meta.env.PUBLIC_SITE_PREVIEW === 'true';
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <link rel="preload" href={manropeFont} as="font" type="font/woff2" crossorigin="anonymous" />
    <link rel="preload" href={spaceGroteskFont} as="font" type="font/woff2" crossorigin="anonymous" />
    <!-- Google Tag Manager -->
    {!isPreview && <script is:inline>(function(w,d,s,l,i){w[l]=w[l]||[];w[l].push({'gtm.start':
    new Date().getTime(),event:'gtm.js'});var f=d.getElementsByTagName(s)[0],
    j=d.createElement(s),dl=l!='dataLayer'?'&l='+l:'';j.async=true;j.src=
    'https://www.googletagmanager.com/gtm.js?id='+i+dl;f.parentNode.insertBefore(j,f);
    })(window,document,'script','dataLayer','GTM-5T5JZMW');</script>}
    <!-- End Google Tag Manager -->
    <!--
      \ / _           _  _____
       Y / \| |   |  / \(_  | 
       | \_/|_|   |__\_/__) | 
      ___    __    __ _     __
       | |_||_    /__|_||V||_ 
       | | ||__   \_|| || ||__
    -->
    {buildRevision && <meta name="velocity-content-revision" content={buildRevision} />}
    <meta name="generator" content={Astro.generator} />
    {import.meta.env.VELOCITY_INTEGRATION_REVISION && <meta name="velocity-integration-revision" content={import.meta.env.VELOCITY_INTEGRATION_REVISION} />}
    <meta name="description" content={description} />
    <!-- Favicon set -->
    <link rel="icon" type="image/x-icon" href="/favicon.ico?v=3" />
    <link rel="icon" type="image/png" sizes="32x32" href="/favicon-32x32.png?v=3" />
    <link rel="icon" type="image/png" sizes="16x16" href="/favicon-16x16.png?v=3" />
    <link rel="apple-touch-icon" sizes="180x180" href="/apple-touch-icon.png?v=3" />
    <link rel="manifest" href="/site.webmanifest?v=3" />
    <title>{title}</title>
    <!-- Open Graph / Facebook -->
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:type" content="website" />
    <meta property="og:url" content={Astro.url} />
    <meta property="og:image" content={socialImage} />
    <meta property="og:image:width" content={socialImageWidth} />
    <meta property="og:image:height" content={socialImageHeight} />
    <meta property="og:site_name" content="Velocity Marketing" />
    
    <!-- Twitter -->
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={socialImage} />
    
    <!-- Additional meta tags for better sharing -->
    <meta name="theme-color" content="#111111" />
    <meta name="msapplication-TileColor" content="#111111" />
    {(noIndex || isPreview) && <meta name="robots" content="noindex, nofollow" />}
    <link rel="canonical" href={canonical} />
  </head>
  <body>
    <!-- Google Tag Manager (noscript) -->
    {!isPreview && <noscript><iframe src="https://www.googletagmanager.com/ns.html?id=GTM-5T5JZMW"
    height="0" width="0" style="display:none;visibility:hidden"></iframe></noscript>}
    <!-- End Google Tag Manager (noscript) -->
    <a class="skip-link" href="#main-content">Skip to content</a>
    <div class="site">
      <Header content={content} editing={editing} />
      <main id="main-content">
        <slot />
      </main>
      <Footer content={content} />
    </div>

    <slot name="editor-script" />
    <script is:inline>
      if ('IntersectionObserver' in window && !window.matchMedia('(prefers-reduced-motion: reduce)').matches) {
        const observer = new IntersectionObserver((entries) => {
          entries.forEach((entry) => {
            if (entry.isIntersecting) {
              entry.target.classList.add('in-view');
              observer.unobserve(entry.target);
            }
          });
        }, { threshold: 0.08 });
        document.querySelectorAll('.reveal').forEach((el) => observer.observe(el));
      }
    </script>
  </body>
</html>
