---
import AdsPage from '../components/pages/AdsPage.astro';
import { locations } from '../../lib/content/locations.js';
import { buildContent } from '../../lib/content/build.js';
export function getStaticPaths() {
  return locations.map(location => ({ params: { location: location.slug } }));
}
---
<AdsPage content={buildContent} locationSlug={Astro.params.location} />
