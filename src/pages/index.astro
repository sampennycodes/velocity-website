---
import Layout from "../layouts/Layout.astro";
import ReviewSlider from "../components/ReviewSlider.astro";
import ContactForm from "../components/ContactForm.astro";
import GoogleRating from "../components/GoogleRating.astro";
import MikeProfile from "../components/MikeProfile.astro";
import HeroProofPoints from "../components/HeroProofPoints.astro";
---

<Layout title="Velocity Marketing — Paid Media Specialist" description="I help businesses achieve measurable growth with strategic, data-driven paid media.">
  <section id="hero" class="section hero home-hero">
    <div class="container">
      <div class="grid hero-layout">
        <div class="hero-copy">
          <h1 class="display">Paid Advertising That Drives <span class="accent-word">Real Growth</span></h1>
          <p class="lead">I help businesses like yours achieve their goals with strategic, results-oriented paid media campaigns.</p>
          <div class="actions">
            <a href="#contact" class="btn primary">Get a Free Consultation <span aria-hidden="true">↗</span></a>
            <a href="#services" class="text-link">Explore Services <span aria-hidden="true">↓</span></a>
          </div>
          <div class="hero-proof"><GoogleRating /></div>
        </div>
        <MikeProfile placement="hero" />
      </div>
      <HeroProofPoints />
    </div>
  </section>

  <section id="services" class="section">
    <div class="container">
      <div class="section-heading reveal"><h2 class="h2">Services</h2></div>
      <div class="services-list">
        <a href="/google-ads-traralgon" class="service-row reveal">
          <span class="service-number">01</span><h3>Google Ads</h3>
          <p>Put your business at the top of search results and connect with customers the moment they're ready to buy or enquire. Explore our local Traralgon campaigns.</p>
          <span class="service-arrow" aria-hidden="true">↗</span>
        </a>
        <article class="service-row reveal">
          <span class="service-number">02</span><h3>Meta Ads</h3>
          <p>Reach more people, spark engagement, and grow your business with precision-targeted advertising on the world's largest social media platform.</p>
        </article>
        <article class="service-row reveal">
          <span class="service-number">03</span><h3>LinkedIn Ads</h3>
          <p>Reach decision-makers, generate qualified B2B leads, and strengthen your brand presence on the world's leading professional network.</p>
        </article>
      </div>
    </div>
  </section>

  <ReviewSlider />

  <section id="about" class="section">
    <div class="container about-layout">
      <div class="reveal">
        <h2 class="h2">Why Work With Me?</h2>
        <MikeProfile placement="about" />
      </div>
      <div class="reveal">
        <p class="lead">My name is Mike Nicholas, and I'm a Paid Media Specialist with a passion for helping businesses succeed. I believe in a data-driven approach and I'm committed to delivering measurable results.</p>
        <ul class="checklist">
          <li>10 years of experience in the industry</li>
          <li>Proven track record with a diverse range of clients</li>
          <li>Certified across Google, Meta, and LinkedIn ad platforms</li>
          <li>Transparent reporting and communication</li>
        </ul>
      </div>
    </div>
  </section>

  <section id="contact" class="section contact-section">
    <div class="container contact-layout">
      <div>
        <h2 class="h2">Let's chat</h2>
        <p class="lead">Ready to grow your paid media? Let's talk.</p>
        <div class="contact-details">
          <a href="mailto:mike@velocitymarketing.com.au">mike@velocitymarketing.com.au</a>
          <a href="tel:0427733566">0427 733 566</a>
        </div>
      </div>
      <ContactForm />
    </div>
  </section>
</Layout>
