---
import Layout from "../layouts/Layout.astro";
import ContactForm from "../components/ContactForm.astro";
import ReviewSlider from "../components/ReviewSlider.astro";

export const excludeFromSitemap = false;

const pageTitle = "Google Ads in Traralgon | Velocity Marketing";
const pageDescription = "Local Google Ads management for Traralgon businesses, built to drive measurable growth.";
const canonicalUrl = "https://velocitymarketing.com.au/google-ads-traralgon";
---

<Layout title={pageTitle} description={pageDescription} canonical={canonicalUrl}>
  <section id="hero" class="section hero">
    <div class="container grid two-col align-center">
      <div class="reveal">
        <div class="badge glass">Traralgon Google Ads</div>
        <h1 class="display text-gradient">Google Ads in Traralgon That Drive Local Growth</h1>
        <p class="lead">Partner with a Traralgon-based Google Ads specialist delivering conversion-focused campaigns for Gippsland businesses.</p>
        <div class="actions">
          <a href="#contact" class="btn primary">Get a Free Consultation</a>
          <a href="#services" class="btn ghost">Explore Specialties</a>
        </div>
        <div class="stats">
          <div class="stat">
            <span class="stat__num">10</span>
            <span class="stat__label">Years Experience</span>
          </div>
          <div class="stat">
            <span class="stat__num">AU</span>
            <span class="stat__label">Local to Traralgon</span>
          </div>
          <div class="stat">
            <span class="stat__num">G Ads</span>
            <span class="stat__label">Google Certified</span>
          </div>
        </div>
      </div>
      <div class="hero-art reveal" aria-hidden="false">
        <img
          src="/img_8071.png"
          alt="Mike Nicholas"
          width="520"
          height="520"
          loading="eager"
          decoding="async"
          class="hero-photo"
        />
      </div>
    </div>
  </section>

  <section id="services" class="section">
    <div class="container">
      <h2 class="h2 center reveal">Some of Our Specialties</h2>
      <div class="grid cards">
        <article class="card hover-lift reveal">
          <h3 class="card__title">Shopping</h3>
          <p class="card__body">Showcase your catalogue in Google Shopping with optimized feeds, smart bidding, and product data that converts ready-to-buy customers.</p>
        </article>
        <article class="card hover-lift reveal">
          <h3 class="card__title">Search</h3>
          <p class="card__body">Own the top of Google Search with tightly structured campaigns aligned to local keywords, intent, and meaningful conversions.</p>
        </article>
        <article class="card hover-lift reveal">
          <h3 class="card__title">Display</h3>
          <p class="card__body">Stay front-of-mind across the Google Display Network with creative, remarketing, and audience targeting that reinforces your message.</p>
        </article>
      </div>
    </div>
  </section>

  <ReviewSlider />

  <section id="about" class="section alt">
    <div class="container grid align-center">
      <div class="reveal">
        <h2 class="h2">Why Work With Me?</h2>
        <p>My name is Mike Nicholas, and I'm a Paid Media Specialist partnering with businesses across Traralgon and the wider Gippsland region. I believe in a data-driven approach and I'm committed to delivering measurable results.</p>
        <ul class="checklist">
          <li>10 years of experience in the industry</li>
          <li>Proven track record with a diverse range of clients</li>
          <li>Certified across Google, Meta, and LinkedIn ad platforms</li>
          <li>Transparent reporting and communication</li>
        </ul>
      </div>
    </div>
  </section>

  <section id="contact" class="section">
    <div class="container center">
      <div class="center">
        <h2 class="h2 reveal">Get in Touch</h2>
      </div>
      <div class="contact-stack">
        <p class="lead reveal contact-lead" style="text-align: center;">Ready to grow your Google Ads in Traralgon? Let's talk.</p>
        <div class="chips reveal" style="text-align: center !important; display: flex !important; justify-content: center !important;">
          <a class="chip" href="mailto:mike@velocitymarketing.com.au">mike@velocitymarketing.com.au</a>
          <a class="chip" href="tel:0427733566">0427 733 566</a>
        </div>

        <ContactForm />
      </div>
    </div>
  </section>


</Layout>
